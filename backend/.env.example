NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tram_k?schema=public
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4203

# Bảo mật & Xác thực
JWT_SECRET=replace-with-at-least-32-random-characters
OUTBOX_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-at-least-32-random-characters
TERMS_VERSION=2026-10-03
PRIVACY_VERSION=2026-10-03
PUBLIC_WEB_URL=http://localhost:4201

# Cấu hình Scheduler (Tự động xuất bản CMS, Tự động đóng Chương trình)
JOBS_ENABLED=true

# Cấu hình Worker Outbox & Cleanup
AUTH_JOBS_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
ACCOUNT_CLEANUP_INTERVAL_MS=3600000

# Chế độ gửi email: log | webhook | smtp
EMAIL_DELIVERY_MODE=log

# Webhook (chỉ cần khi dùng webhook)
# EMAIL_WEBHOOK_URL=https://email-gateway.example.com/send
# EMAIL_WEBHOOK_TOKEN=replace-with-a-private-webhook-token

# Gmail SMTP (chỉ cần khi dùng smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Trạm K <no-reply@gmail.com>

# Trợ lý AI
AI_PROVIDER=local
# OPENAI_API_KEY=replace-with-your-private-api-key
OPENAI_MODEL=gpt-6-luna
AI_RATE_LIMIT_PER_MINUTE=12

# Đường dẫn lưu trữ File (Lưu ý: Đổi đường dẫn cho phù hợp với máy của bạn)
# Thư mục lưu ảnh/audio công khai
MEDIA_STORAGE_PATH=E:/TramK/media
# Thư mục lưu giấy tờ đối tác (Bảo mật, không public)
PARTNER_DOCUMENT_STORAGE_PATH=E:/TramK/partner-documents