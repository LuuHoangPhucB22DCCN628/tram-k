generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  PATIENT
  CARER
  PARTNER
}

enum UserStatus {
  PENDING_VERIFY
  ACTIVE
  LOCKED
  DISABLED
}

enum ConsentType {
  TERMS
  PRIVACY
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  EMAIL_CHANGE
  PASSWORD_RESET
}

enum AuthTokenSource {
  SIGNUP
  RESEND
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum HairRegistrationMode {
  RECEIVE
  DONATE
}

enum HairRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum PartnerApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum CommunityReactionType {
  LIKE
  LOVE
  SUPPORT
}

enum NotificationKind {
  PROGRAM_REGISTRATION_SENT
  PROGRAM_REGISTRATION_RECEIVED
  PROGRAM_REGISTRATION_CONFIRMED
  PROGRAM_REGISTRATION_REJECTED
  PROGRAM_REGISTRATION_COMPLETED
  PROGRAM_PUBLISHED
  PROGRAM_REJECTED
  PROGRAM_SUBMITTED 
  PARTNER_APPLICATION_APPROVED
  PARTNER_APPLICATION_REJECTED
  SUPPORT_POINT_APPROVED
  SUPPORT_POINT_REJECTED
}

enum SearchDocumentType {
  GUIDE
  CANCER_TYPE
  STORY
  SUPPORT_PROGRAM
}

enum ManagedResourceStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum SupportProgramRegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
  EXPIRED
  ATTENDED
  NO_SHOW
}

enum AiConversationMessageRole {
  USER
  ASSISTANT
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

enum PostStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
  ARCHIVED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  HIDE
  RESTORE
  SOFT_DELETE
  DISMISS
}

enum ModerationTargetType {
  POST
  COMMENT
}

enum SupportPointStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
  ARCHIVED
}

enum ProgramStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

model Role {
  id        String   @id @default(cuid())
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id                          String                       @id @default(cuid())
  email                       String                       @unique
  passwordHash                String                       @map("password_hash")
  fullName                    String                       @map("full_name")
  status                      UserStatus                   @default(PENDING_VERIFY)
  emailVerifiedAt             DateTime?                    @map("email_verified_at")
  authVersion                 Int                          @default(1) @map("auth_version")
  loginBlockedUntil           DateTime?                    @map("login_blocked_until")
  verificationCleanupAt       DateTime?                    @map("verification_cleanup_at")
  deletedAt                   DateTime?                    @map("deleted_at")
  deletedById                 String?                      @map("deleted_by_id")
  deletedBy                   User?                        @relation("UserDeletedBy", fields: [deletedById], references: [id])
  deletedUsers                User[]                       @relation("UserDeletedBy")
  roleId                      String                       @map("role_id")
  role                        Role                         @relation(fields: [roleId], references: [id])
  partnerApplication          PartnerApplication?          @relation("PartnerApplicant")
  reviewedPartnerApplications PartnerApplication[]         @relation("PartnerReviewer")
  partnerMembership           PartnerMembership?           @relation("PartnerMember")
  grantedPartnerMemberships   PartnerMembership[]          @relation("PartnerGranter")
  communityComments           CommunityComment[]
  communityReactions          CommunityReaction[]
  notifications               Notification[]
  supportProgramRegistrations SupportProgramRegistration[]
  partnerApplicationDocuments PartnerApplicationDocument[]
  authSessions                AuthSession[]
  authTokens                  AuthToken[]
  consents                    UserConsent[]
  authAttempts                AuthAttempt[]
  aiConversations             AiConversation[]
  posts                       Post[]
  reports                     Report[]
  contents                    Content[]                    @relation("ContentReviewer")
  profile                     UserProfile?
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  
  @@index([roleId])
  @@index([status, deletedAt])
  @@index([verificationCleanupAt])
  @@index([deletedById])
  @@map("users")
}

model AiConversation {
  id        String                  @id @default(cuid())
  userId    String                  @map("user_id")
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String                  @default("Cuộc trò chuyện mới") @db.VarChar(120)
  messages  AiConversationMessage[]
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiConversationMessage {
  id             String                    @id @default(cuid())
  conversationId String                    @map("conversation_id")
  conversation   AiConversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiConversationMessageRole
  content        String                    @db.Text
  mode           String?                   @db.VarChar(20)
  sources        Json?
  createdAt      DateTime                  @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("ai_conversation_messages")
}

model UserProfile {
  userId        String            @id @map("user_id")
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone         String?
  city          String?
  birthYear     Int?              @map("birth_year")
  bio           String?           @db.VarChar(500)
  avatarUrl     String?
  visibility    ProfileVisibility @default(MEMBERS)
  showEmail     Boolean           @default(false) @map("show_email")
  allowComments Boolean           @default(true) @map("allow_comments")
  version       Int               @default(1)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model UserConsent {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id])
  type        ConsentType
  version     String
  acceptedAt  DateTime    @map("accepted_at")
  source      String
  withdrawnAt DateTime?   @map("withdrawn_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([userId, type, version])
  @@index([userId, type, withdrawnAt])
  @@map("user_consents")
}

model AuthToken {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id])
  purpose     AuthTokenPurpose
  tokenHash   String           @unique @map("token_hash")
  targetEmail String?          @unique @map("target_email")
  source      AuthTokenSource  @default(SIGNUP)
  expiresAt   DateTime         @map("expires_at")
  usedAt      DateTime?        @map("used_at")
  revokedAt   DateTime?        @map("revoked_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuthAttempt {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  emailHash String   @map("email_hash")
  ipHash    String   @map("ip_hash")
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
  @@map("auth_attempts")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventId       String       @unique @map("event_id")
  type          String
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  sentAt        DateTime?    @map("sent_at")
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorType     String   @map("actor_type")
  actorId       String?  @map("actor_id")
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  before        Json?
  after         Json?
  reason        String?
  ipHash        String?  @map("ip_hash")
  correlationId String   @map("correlation_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}

model AuthSession {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  tokenHash   String    @unique @map("token_hash")
  familyId    String    @map("family_id")
  authVersion Int       @default(1) @map("auth_version")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model CommunityComment {
  id             String             @id @default(cuid())
  userId         String             @map("user_id")
  user           User               @relation(fields: [userId], references: [id])
  sourceKey      String             @map("source_key")
  sourceTitle    String             @map("source_title")
  sourcePath     String             @map("source_path")
  parentId       String?            @map("parent_id")
  parent         CommunityComment?  @relation("CommunityCommentReplies", fields: [parentId], references: [id])
  replies        CommunityComment[] @relation("CommunityCommentReplies")
  content        String
  status         String             @default("PUBLISHED")
  contentVersion Int                @default(1) @map("content_version")
  version        Int                @default(0)
  deletedById    String?            @map("deleted_by_id")
  idempotencyKey String             @map("idempotency_key")
  deletedAt      DateTime?          @map("deleted_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([userId, idempotencyKey])
  @@index([sourceKey, createdAt])
  @@index([parentId])
  @@map("community_comments")
}

model CommunityReaction {
  id        String                @id @default(cuid())
  userId    String                @map("user_id")
  user      User                  @relation(fields: [userId], references: [id])
  sourceKey String                @map("source_key")
  type      CommunityReactionType
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@unique([userId, sourceKey])
  @@index([sourceKey, type])
  @@map("community_reactions")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String           @map("recipient_id")
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  kind        NotificationKind
  title       String           @db.VarChar(160)
  message     String           @db.VarChar(1000)
  link        String           @db.VarChar(500)
  dedupeKey   String?          @map("dedupe_key") @db.VarChar(255)
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

model SearchDocument {
  id              String             @id @default(cuid())
  sourceId        String             @map("source_id")
  type            SearchDocumentType
  title           String             @db.VarChar(160)
  description     String             @db.VarChar(1000)
  eyebrow         String             @db.VarChar(80)
  metadata        String             @db.VarChar(255)
  imageUrl        String?            @map("image_url") @db.VarChar(500)
  imageAlt        String?            @map("image_alt") @db.VarChar(255)
  link            String             @db.VarChar(500)
  queryParams     Json?              @map("query_params")
  normalizedTitle String             @map("normalized_title") @db.Text
  normalizedText  String             @map("normalized_text") @db.Text
  publishedAt     DateTime           @map("published_at")
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@unique([type, sourceId])
  @@index([active, type, publishedAt])
  @@index([normalizedText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("search_documents")
}

model ManagedResource {
  id          String                @id @default(cuid())
  sourceId    String                @map("source_id")
  type        SearchDocumentType
  status      ManagedResourceStatus
  title       String                @db.VarChar(160)
  description String                @db.VarChar(1000)
  payload     Json
  publishedAt DateTime              @map("published_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@unique([type, sourceId])
  @@index([status, type, publishedAt])
  @@map("managed_resources")
}

model SupportProgramRegistration {
  id             String                           @id @default(cuid())
  programId      String                           @map("program_id")
  program        Program                          @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId         String                           @map("user_id")
  user           User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicantName  String                           @map("applicant_name") @db.VarChar(160)
  applicantEmail String                           @map("applicant_email") @db.VarChar(255)
  status         SupportProgramRegistrationStatus @default(CONFIRMED)
  decisionReason String?                          @map("decision_reason") @db.VarChar(1000)
  registeredAt   DateTime                         @default(now()) @map("registered_at")
  waitlistedAt   DateTime?                        @map("waitlisted_at")
  confirmedAt    DateTime?                        @map("confirmed_at")
  cancelledAt    DateTime?                        @map("cancelled_at")
  cancelReason   String?                          @map("cancel_reason") @db.VarChar(1000)
  attendedAt     DateTime?                        @map("attended_at")
  version        Int                              @default(0)
  updatedAt      DateTime                         @updatedAt @map("updated_at")
  statusHistory  RegistrationStatusHistory[]

  @@unique([programId, userId])
  @@index([programId, status, registeredAt])
  @@index([userId, registeredAt])
  @@map("support_program_registrations")
}

model PartnerApplication {
  id                 String                       @id @default(cuid())
  applicantId        String                       @unique @map("applicant_id")
  applicant          User                         @relation("PartnerApplicant", fields: [applicantId], references: [id])
  
  organizationName   String?                      @map("organization_name") 
  representativeName String?                      @map("representative_name")
  phone              String?
  email              String?
  address            String?
  introduction       String?
  
  trackingCode       String?                      @unique @map("tracking_code")
  
  documentKeys       String[]                     @default([]) @map("document_keys")
  status             PartnerApplicationStatus     @default(DRAFT)
  version            Int                          @default(0)
  
  reviewReason       String?                      @map("review_reason")
  reviewedById       String?                      @map("reviewed_by_id")
  reviewedBy         User?                        @relation("PartnerReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?                    @map("reviewed_at")
  membership         PartnerMembership?
  documents          PartnerApplicationDocument[]
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([reviewedById])
  @@map("partner_applications")
}

model PartnerApplicationDocument {
  id            String              @id @default(uuid())
  ownerId       String              @map("owner_id")
  owner         User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applicationId String?             @map("application_id")
  application   PartnerApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  storageKey    String              @unique @map("storage_key")
  originalName  String              @map("original_name") @db.VarChar(255)
  mimeType      String              @map("mime_type") @db.VarChar(100)
  size          Int
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([ownerId, createdAt])
  @@index([applicationId])
  @@map("partner_application_documents")
}

model PartnerMembership {
  id            String             @id @default(cuid())
  userId        String             @unique @map("user_id")
  user          User               @relation("PartnerMember", fields: [userId], references: [id])
  status        PartnerStatus      @default(ACTIVE)
  applicationId String             @unique @map("application_id")
  application   PartnerApplication @relation(fields: [applicationId], references: [id])
  grantedById   String             @map("granted_by_id")
  grantedBy     User               @relation("PartnerGranter", fields: [grantedById], references: [id])
  grantedAt     DateTime           @default(now()) @map("granted_at")
  supportPoints SupportPoint[]
  programs      Program[]

  @@index([grantedById])
  @@map("partner_memberships")
}

model HairRegistration {
  id                  String                 @id @default(cuid())
  reference           String                 @unique
  mode                HairRegistrationMode
  status              HairRegistrationStatus @default(PENDING)
  fullName            String                 @map("full_name")
  phone               String
  email               String?
  province            String
  district            String
  address             String
  gender              String
  relativePhone       String?                @map("relative_phone")
  relativeName        String?                @map("relative_name")
  duration            String?
  hospital            String?
  diagnosis           String?
  borrowDate          DateTime?              @map("borrow_date") @db.Date
  desiredLength       String?                @map("desired_length")
  transparency        String?
  donationLocation    String?                @map("donation_location")
  donatedLength       String?                @map("donated_length")
  acceptedCommitments String[]               @default([]) @map("accepted_commitments")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@index([mode, status])
  @@index([createdAt])
  @@map("hair_registrations")
}

model RegistrationStatusHistory {
  id             String                     @id @default(cuid())
  registrationId String                     @map("registration_id")
  registration   SupportProgramRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  fromStatus SupportProgramRegistrationStatus? @map("from_status")
  toStatus   SupportProgramRegistrationStatus  @map("to_status")
  reason     String?                           @db.VarChar(1000)
  actorId    String?                           @map("actor_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("registration_status_histories")
}

model Post {
  id                String       @id @default(cuid())
  authorId          String       @map("author_id")
  author            User         @relation(fields: [authorId], references: [id])
  status            PostStatus   @default(DRAFT)
  currentRevisionId String?      @unique @map("current_revision_id")
  currentRevision   PostRevision? @relation("CurrentRevision", fields: [currentRevisionId], references: [id])
  revisions         PostRevision[] @relation("PostRevisions")
  
  publishedAt       DateTime?    @map("published_at")
  version           Int          @default(0)
  
  deletedAt         DateTime?    @map("deleted_at")
  deletedById       String?      @map("deleted_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([authorId])
  @@map("posts")
}

model PostRevision {
  id                String       @id @default(cuid())
  postId            String       @map("post_id")
  post              Post         @relation("PostRevisions", fields: [postId], references: [id], onDelete: Cascade)
  
  currentForPost    Post?        @relation("CurrentRevision")
  
  revisionNumber    Int          @map("revision_number")
  title             String       @db.VarChar(160)
  summary           String?      @db.VarChar(500)
  sanitizedBody     String       @map("sanitized_body") @db.Text
  contentHash       String       @map("content_hash")
  
  createdById       String       @map("created_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")

  @@unique([postId, revisionNumber])
  @@map("post_revisions")
}

model Report {
  id                String               @id @default(cuid())
  reporterId        String               @map("reporter_id")
  reporter          User                 @relation(fields: [reporterId], references: [id])
  
  targetType        ModerationTargetType @map("target_type")
  targetId          String               @map("target_id")
  targetRevisionId  String?              @map("target_revision_id") 
  targetContentVersion Int?              @map("target_content_version") 
  
  reasonCode        String               @map("reason_code") @db.VarChar(50)
  details           String?              @db.Text
  snapshot          Json?               
  
  status            ReportStatus         @default(OPEN)
  version           Int                  @default(0)
  
  reviewedById      String?              @map("reviewed_by_id")
  reviewedAt        DateTime?            @map("reviewed_at")
  resolutionCode    String?              @map("resolution_code")
  
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  holds             ModerationHold[]
  actions           ModerationAction[]

  @@index([targetType, targetId, status])
  @@index([reporterId, status])
  @@map("reports")
}

model ModerationHold {
  id                String               @id @default(cuid())
  reportId          String               @map("report_id")
  report            Report               @relation(fields: [reportId], references: [id])
  
  targetType        ModerationTargetType @map("target_type")
  targetId          String               @map("target_id")
  targetRevisionId  String?              @map("target_revision_id")
  targetContentVersion Int?              @map("target_content_version")
  
  status            String               @default("ACTIVE")
  releasedAt        DateTime?            @map("released_at")
  releasedById      String?              @map("released_by_id")
  
  createdAt         DateTime             @default(now()) @map("created_at")
  createdById       String               @map("created_by_id")

  @@index([targetType, targetId, status])
  @@map("moderation_holds")
}

model ModerationAction {
  id                String               @id @default(cuid())
  reportId          String?              @map("report_id")
  report            Report?              @relation(fields: [reportId], references: [id])
  
  actionType        ModerationActionType @map("action_type")
  targetType        ModerationTargetType @map("target_type")
  targetId          String               @map("target_id")
  targetRevisionId  String?              @map("target_revision_id")
  targetContentVersion Int?              @map("target_content_version")
  
  reason            String               @db.Text
  supersedesActionId String?             @map("supersedes_action_id")
  
  createdAt         DateTime             @default(now()) @map("created_at")
  createdById       String               @map("created_by_id")

  @@index([targetType, targetId])
  @@map("moderation_actions")
}

model SupportPoint {
  id              String             @id @default(cuid())
  ownerPartnerId  String             @map("owner_partner_id")
  owner           PartnerMembership  @relation(fields: [ownerPartnerId], references: [id])
  
  name            String             @db.VarChar(160)
  description     String             @db.VarChar(1000)
  address         String             @db.VarChar(255)
  latitude        Float
  longitude       Float
  contactPhone    String?            @map("contact_phone")
  contactEmail    String?            @map("contact_email")
  operatingHours  String?            @map("operating_hours")
  supportType     String             @map("support_type") @db.VarChar(50)
  
  status          SupportPointStatus @default(DRAFT)
  version         Int                @default(0)
  publishedAt     DateTime?          @map("published_at")
  deletedAt       DateTime?          @map("deleted_at")
  deletedById     String?            @map("deleted_by_id")
  
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([ownerPartnerId, status])
  @@map("support_points")
}

model Program {
  id                   String              @id @default(cuid())
  ownerPartnerId       String              @map("owner_partner_id")
  owner                PartnerMembership   @relation(fields: [ownerPartnerId], references: [id])
  
  title                String              @db.VarChar(160)
  description          String              @db.VarChar(10000)
  address              String              @db.VarChar(255)
  latitude             Float
  longitude            Float
  conditions           String?             @db.Text
  registrationOpenAt   DateTime            @map("registration_open_at")
  registrationCloseAt  DateTime            @map("registration_close_at")
  startAt              DateTime            @map("start_at")
  endAt                DateTime            @map("end_at")
  capacity             Int
  
  status               ProgramStatus       @default(DRAFT)
  version              Int                 @default(0)
  publishedAt          DateTime?           @map("published_at")
  hiddenReason         String?             @map("hidden_reason")
  cancelReason         String?             @map("cancel_reason")
  
  deletedAt            DateTime?           @map("deleted_at")
  deletedById          String?             @map("deleted_by_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  registrations        SupportProgramRegistration[]
  statusHistory        ProgramStatusHistory[]

  @@index([status, registrationOpenAt])
  @@index([ownerPartnerId, status])
  @@map("programs")
}

model ProgramStatusHistory {
  id           String        @id @default(cuid())
  programId    String        @map("program_id")
  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  fromStatus   ProgramStatus? @map("from_status")
  toStatus     ProgramStatus @map("to_status")
  reason       String?
  actorId      String?       @map("actor_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([programId, createdAt])
  @@map("program_status_histories")
}

model Source {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(255)
  url       String?   @db.VarChar(500)
  contents  Content[]
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("sources")
}

model Content {
  id                    String              @id @default(cuid())
  slug                  String              @unique
  type                  SearchDocumentType  
  status                ContentStatus       @default(DRAFT)
  
  title                 String              @db.VarChar(160)
  summary               String?             @db.VarChar(500)
  
  currentRevisionId     String?             @unique @map("current_revision_id")
  currentRevision       ContentRevision?    @relation("CurrentRevision", fields: [currentRevisionId], references: [id])
  revisions             ContentRevision[]   @relation("ContentRevisions")
  
  sourceId              String?             @map("source_id")
  source                Source?             @relation(fields: [sourceId], references: [id])
  reviewedById          String?             @map("reviewed_by_id")
  reviewedBy            User?               @relation("ContentReviewer", fields: [reviewedById], references: [id])
  reviewedAt            DateTime?           @map("reviewed_at")
  nextReviewAt          DateTime?           @map("next_review_at")
  
  publishAt             DateTime?           @map("publish_at")
  publishedAt           DateTime?           @map("published_at")
  publishFailureReason  String?             @map("publish_failure_reason") @db.Text
  
  version               Int                 @default(0)
  deletedAt             DateTime?           @map("deleted_at")
  deletedById           String?             @map("deleted_by_id")
  
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([type, status])
  @@map("contents")
}

model ContentRevision {
  id            String    @id @default(cuid())
  contentId     String    @map("content_id")
  content       Content   @relation("ContentRevisions", fields: [contentId], references: [id], onDelete: Cascade)
  currentFor    Content?  @relation("CurrentRevision")
  
  revisionNumber Int      @map("revision_number")
  title          String   @db.VarChar(160)
  summary        String?  @db.VarChar(500)
  sanitizedBody  String   @map("sanitized_body") @db.Text
  contentHash    String   @map("content_hash")
  
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([contentId, revisionNumber])
  @@map("content_revisions")
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  actorScope     String   @map("actor_scope")  
  operation      String                        
  key            String                          
  payloadHash    String   @map("payload_hash")  
  responseStatus Int      @map("response_status")
  status         IdempotencyStatus @default(PROCESSING)
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([actorScope, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}